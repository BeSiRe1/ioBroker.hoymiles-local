{
  "name": "iobroker.hoymiles-local",
  "version": "0.6.0",
  "description": "Local Hoymiles DTU reader with PV monitoring, complete power history and midnight daily energy reset",
  "main": "main.js",
  "license": "MIT",
  "author": "BeSiRe1",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeSiRe1/ioBroker.hoymiles-local.git"
  },
  "bugs": {
    "url": "https://github.com/BeSiRe1/ioBroker.hoymiles-local/issues"
  },
  "homepage": "https://github.com/BeSiRe1/ioBroker.hoymiles-local#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:package && npm run test:integration",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js",
    "test:package": "mocha --exit test/package.js",
    "test:integration": "mocha --exit test/integration.js",
    "build": "tsc -p tsconfig.json"
  },
  "files": [
    "main.js",
    "lib/",
    "admin/",
    "protocol/",
    "io-package.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ioBroker",
    "hoymiles",
    "dtu",
    "energy"
  ],
  "dependencies": {
    "@iobroker/adapter-core": "3.4.3",
    "protobufjs": "8.8.1"
  },
  "devDependencies": {
    "@iobroker/testing": "6.3.1",
    "@types/node": "22.20.5",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
}

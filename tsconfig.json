{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleDetection": "force",
    "rootDir": "src",
    "outDir": ".",
    "types": [
      "node",
      "@iobroker/types"
    ],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "newLine": "lf"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
